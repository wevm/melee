{
  "name": "ondine",
  "description": "Monochrome Mermaid diagrams, compiled with TypeScript.",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fubhy/ondine.git"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "bench": "node scripts/bench.ts",
    "build": "node scripts/build.ts",
    "check:types": "tsc --noEmit",
    "fuzz": "node scripts/fuzz.ts",
    "oracle": "node scripts/oracle.ts",
    "test": "vitest run",
    "test:dist": "pnpm build && ONDINE_ENTRY=../dist/index.js vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rolldown": "1.2.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}
