{
  "scripts": {
    "bench": "pnpm build:wasm && vp test bench --run --no-file-parallelism && tsx bench/compare.ts",
    "bench:compare": "pnpm build:wasm && tsx bench/compare.ts",
    "build": "pnpm build:wasm && zile",
    "build:wasm": "node scripts/build-wasm.ts",
    "changeset:publish": "pnpm build:wasm && zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp check --fix",
    "check:size": "node scripts/size.ts",
    "check:types": "tsc && pnpm --dir site generate-routes && tsc -p site && pnpm --dir video diagrams && tsc -p video",
    "dev": "pnpm build:wasm && zile dev",
    "postinstall": "zile dev",
    "size:report": "node scripts/size-report.ts",
    "test": "pnpm build:wasm && vp test",
    "test:packed": "pnpm build:wasm && vp test run --config scripts/packed-consumer.config.ts",
    "test:screenshots": "pnpm build:wasm && vp test --run --project screenshots --update"
  },
